# Development uses SQLite automatically. Set DATABASE_URL for production.
APP_ENV=development
DATABASE_URL=sqlite:///./data/healthflow.db

# Optional MySQL production settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=healthflow

# Optional retrieval services
MILVUS_HOST=localhost
MILVUS_PORT=19530
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# OpenAI-compatible vLLM endpoint
VLLM_HOST=localhost
VLLM_PORT=8000
VLLM_MODEL=qwen-vl-plus
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_OFFLINE=true

# Only needed by local data-generation scripts; never commit a real key.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7

API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ROUTER_CONFIDENCE_THRESHOLD=0.55
MAX_RECURSION=3
MAX_UPLOAD_BYTES=20971520
